{
  // The llama-local provider points at a single llama-server, which serves
  // exactly one model at a time: whichever model you have loaded. It also
  // ignores the "model" field in requests. So instead of one entry per
  // model, there is exactly ONE stable "slot" entry here.
  //
  //   id   "current" is sent in every API request. llama-server ignores it,
  //         so it never changes. Always run pi with:
  //             --model llama-local/current
  //   name Human-readable label shown in /model. Update it by hand when
  //         you switch models -- it is documentation only and never
  //         affects which model answers.
  //   reasoning / thinkingLevelMap The only fields worth editing: adjust
  //         them when the model you switch to has different thinking
  //         capabilities.
  //   contextWindow  Rendered from the LLAMA_CONTEXT_WINDOW environment
  //         variable (see scripts/run.sh, default 128000). Match it to the
  //         context you run llama-server with (its -c flag). You can read
  //         the value from the running server:
  //             curl -s localhost:8080/v1/models | jq -r '.data[0].meta.n_ctx'
  //   maxTokens      Ceiling for the model's output per response, including
  //         thinking. pi's built-in default is 16384, which is too small for
  //         models that think in 30k-token bursts. Keep it <= contextWindow.
  //         Note: pi rejects non-positive values (there is no "unlimited"
  //         sentinel for custom models), so raise this number if you need a
  //         higher ceiling.
  //   compat.maxTokensField  llama-server's OpenAI-compatible endpoint expects
  //         "max_tokens", not the newer "max_completion_tokens".
  //
  // Do NOT add one entry per GGUF file: llama-server cannot switch models
  // per request, so extra entries would be misleading.
  "providers": {
    "llama-local": {
      "baseUrl": "http://__EGRESS_PROXY_IP__:__EGRESS_PROXY_PORT__/v1",
      "api": "openai-completions",
      "apiKey": "__PROVIDER_API_KEY__",
      "models": [
        {
          "id": "current",
          "name": "currently loaded model (llama-server)",
          "contextWindow": __CONTEXT_WINDOW__,
          "maxTokens": 65536,
          "reasoning": true,
          "compat": {
            "maxTokensField": "max_tokens"
          },
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "high": null,
            "low": "low",
            "medium": "medium",
            "xhigh": "xhigh"
          }
        }
      ]
    }
  }
}
